# SoilTrace Backend Gateway Configuration
# Copy this file to `backend/.env` to enable real SMS gateway integration.

# Option 1: Fast2SMS (Recommended for Indian +91 numbers - free developer tier available)
# Sign up at https://www.fast2sms.com and get your API key from Dev API section
FAST2SMS_API_KEY=

# Option 2: Twilio SMS (Global carrier gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Note: If no SMS keys are configured, SoilTrace operates with simulated telecom carrier dispatch
